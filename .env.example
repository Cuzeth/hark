# --- Website / API (apps/website) -----------------------------------------

# Public origin the browser uses. Dev default: the Vite server.
# Production: https://hark.ryan.ceo
APP_URL=http://localhost:5173

# SQLite file. Dev default: ./data/hark.sqlite (relative to apps/website).
# Production (Docker): /data/hark.sqlite
DATABASE_URL=./data/hark.sqlite

# Required in production. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Google OAuth web credentials (Google Cloud Console → APIs & Services →
# Credentials → OAuth client ID, type "Web application").
# Authorized redirect URIs:
#   http://localhost:8787/api/auth/callback/google
#   https://hark.ryan.ceo/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional: Expo access token (expo.dev → Account settings → Access tokens).
# Enables authenticated requests to the Expo Push Service.
EXPO_ACCESS_TOKEN=

# Webhook limits measured over a rolling 60-second window.
SERVICE_RATE_LIMIT_PER_MINUTE=60
ACCOUNT_RATE_LIMIT_PER_MINUTE=300
PRO_SERVICE_RATE_LIMIT_PER_MINUTE=300
PRO_ACCOUNT_RATE_LIMIT_PER_MINUTE=1500

# Autumn production secret key. Used only by the website server.
AUTUMN_API_KEY=

# API port (Hono). The Vite dev server proxies /api and /hooks here.
PORT=8787

# --- Expo app (apps/expo) ---------------------------------------------------

# Where the app reaches the API. Use your machine's LAN IP in development so a
# physical iPhone can connect, e.g. http://192.168.1.20:8787
EXPO_PUBLIC_API_URL=http://localhost:8787

# EAS project id (from `eas init`); required for Expo push tokens.
EAS_PROJECT_ID=

# Apple Developer team id, consumed by @bacons/apple-targets at prebuild.
APPLE_TEAM_ID=
