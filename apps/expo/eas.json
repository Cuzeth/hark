{
  "cli": {
    "version": ">= 16.20.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://hark.ryan.ceo"
      }
    },
    "development-simulator": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "simulator": true
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://hark.ryan.ceo"
      }
    },
    "production": {
      "autoIncrement": true,
      "distribution": "store",
      "ios": {
        "buildConfiguration": "Release"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://hark.ryan.ceo"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "appleTeamId": "9G68SMNHEU",
        "appName": "Hark",
        "bundleIdentifier": "ceo.ryan.hark",
        "language": "en-US",
        "sku": "hark-ios"
      }
    }
  }
}
